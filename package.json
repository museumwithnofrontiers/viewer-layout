{
  "name": "@museumwnf/viewer-layout",
  "version": "2.18.0",
  "description": "Page structure for MWNF websites: PageShell composing seven optional, token-styled sections, the content components a page is made of, and the composed views a website names instead of writing a page.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/museumwithnofrontiers/viewer-layout.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "src/tokens.reference.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./content": "./dist/content.js",
    "./views": "./dist/views.js",
    "./components": "./dist/components.js",
    "./dxa": "./dist/dxa.js",
    "./style.css": "./dist/viewer-layout.css",
    "./tokens.reference.css": "./src/tokens.reference.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@museumwnf/viewer-core": "^2.3.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0 || ^5.0.0"
  },
  "devDependencies": {
    "@museumwnf/viewer-core": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.0",
    "vue-router": "^5.3.1"
  }
}
